{
  "name": "ar-mining-training",
  "private": true,
  "version": "0.0.0",
  "description": "AR Mining Training App – SIH 2026 (PS SIH26041)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev -w @ar-training/mobile",
    "dev:mobile": "npm run dev -w @ar-training/mobile",
    "dev:api": "node scripts/dev-api.mjs",
    "setup:api": "node scripts/setup-api.mjs",
    "phone": "node scripts/phone.mjs --open",
    "phone:reverse": "node scripts/phone.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present && npm run test:api",
    "test:api": "node scripts/test-api.mjs",
    "android": "node scripts/android.mjs",
    "app": "npm run build -w @ar-training/mobile && npm run preview -w @ar-training/mobile",
    "phone:app": "node scripts/phone.mjs --open --app",
    "i18n:export": "node scripts/i18n-export.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
